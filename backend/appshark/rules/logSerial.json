{
  "serial_Log": {
    "SliceMode": true,
    "traceDepth": 12,
    "PrimTypeAsTaint": true,
    "desc": {
      "name": "serial_Log",
      "detail": "将设备序列号写入日志",
      "detail_en": "write serial to log",
      "category": "ComplianceInfo",
      "complianceCategory": "serial_Log",
      "complianceCategoryDetail": "设备序列号写入日志",
      "level": "L4",
      "provenance": {
        "repo": "bytedance/appshark",
        "commit": "487fa2175c4a6ccbfb5a330b5e3ed0081de3bfeb",
        "source_path": "config/rules/logSerial.json",
        "license": "Apache-2.0",
        "vendor": "upstream",
        "verified": false
      }
    },
    "source": {
      "Field": [
        "<android.os.Build: * SERIAL>"
      ]
    },
    "sink": {
      "<android.util.Log: * d(*)>": {
        "TaintCheck": [
          "p*"
        ]
      },
      "<android.util.Log: * e(*)>": {
        "TaintCheck": [
          "p*"
        ]
      },
      "<android.util.Log: * i(*)>": {
        "TaintCheck": [
          "p*"
        ]
      },
      "<android.util.Log: * w(*)>": {
        "TaintCheck": [
          "p*"
        ]
      },
      "<android.util.Log: * v(*)>": {
        "TaintCheck": [
          "p*"
        ]
      }
    }
  }
}